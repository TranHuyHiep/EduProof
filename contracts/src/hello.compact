pragma language_version 0.26;

import CompactStandardLibrary;

export ledger proofCount: Counter;

// Smallest possible circuit: proves a private value clears a public threshold
// without revealing the value. If this compiles and runs, the toolchain works.
export circuit proveThreshold(value: Uint<16>, threshold: Uint<16>): Boolean {
  proofCount.increment(1);
  return value >= threshold;
}
