# Copy to .env.local and fill in.

# ── The school's GraphQL endpoint, as the BROWSER reaches it ──────────────
#
# The school is a separate vendor with its own system. Two ways to run it:
#
#   /api/school/graphql            in-app route standing in for a school.
#                                  Used by the single-deployment demo.
#   http://localhost:4000/graphql  a real school service (npm run school,
#                                  or the school-api container). This is the
#                                  honest architecture — use it for demos.
NEXT_PUBLIC_SCHOOL_API=/api/school/graphql

# ── The school's issuer signing key ───────────────────────────────────────
#
# Ed25519 private key, base64 PKCS8. Generate with:
#   npm run school:genkey
#
# REQUIRED in any deployment. The key must be stable across restarts: a
# verifier checks signatures against the public key published in the school
# profile, so a key regenerated at boot invalidates every credential already
# issued. On serverless it would differ per request.
#
# Put the matching PUBLIC key in data/schools.json as issuerPublicKey.
SCHOOL_SIGNING_KEY=

# ── Which proof system to use ─────────────────────────────────────────────
#
#   mock      No cryptography. Claim outcomes are computed in TypeScript, and
#             the proof payload is random. The DEFAULT, so that cloning the
#             repo and running `npm run dev` gives a working demo with no
#             toolchain, no wallet and no network.
#   midnight  The compiled Compact circuit. A claim outcome becomes the
#             circuit's verdict, and it refuses to produce one unless the
#             school's signature verifies and the caller holds the credential.
#
# Optional. Omit for mock.
NEXT_PUBLIC_PROOF_PROVIDER=mock

# ── Midnight network ──────────────────────────────────────────────────────
#
# All optional: each falls back to the value shown, which is what the
# verification on 2026-08-29 was run against.

# Preview network RPC.
NEXT_PUBLIC_MIDNIGHT_RPC=https://rpc.preview.midnight.network

# Preview network indexer.
NEXT_PUBLIC_MIDNIGHT_INDEXER=https://indexer.preview.midnight.network/api/v3/graphql

# The proving service.
#
# The hosted endpoint answers with permissive CORS, so the browser calls it
# directly and no proxy of ours stands in the middle. That matters: a proxy
# would see the witness, which is the one thing this design refuses.
#
# The trade-off that remains, and which the README states plainly: whoever
# runs a proof server DOES see the witness. A production deployment should run
# one on the user's side. To do that locally:
#
#   docker run -p 6300:6300 midnightntwrk/proof-server:8.0.3
#   NEXT_PUBLIC_PROOF_SERVER=http://localhost:6300
NEXT_PUBLIC_PROOF_SERVER=https://proof-server.preprod.midnight.network

# The deployed contract address.
#
# Empty until the contract is deployed to the preview network. While it is
# empty, verification says so rather than showing a tick that means nothing.
NEXT_PUBLIC_CONTRACT_ADDRESS=
