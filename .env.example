# Copy to .env.local and fill in.

# ── The school's GraphQL endpoint, as the BROWSER reaches it ──────────────
#
# The school is a separate vendor with its own system. Two ways to run it:
#
#   /api/school/graphql            in-app route standing in for a school.
#                                  Used by the single-deployment demo.
#   http://localhost:4000/graphql  a real school service (npm run school,
#                                  or the school-api container). This is the
#                                  honest architecture — use it for demos.
NEXT_PUBLIC_SCHOOL_API=/api/school/graphql

# ── The school's issuer signing key ───────────────────────────────────────
#
# Ed25519 private key, base64 PKCS8. Generate with:
#   npm run school:genkey
#
# REQUIRED in any deployment. The key must be stable across restarts: a
# verifier checks signatures against the public key published in the school
# profile, so a key regenerated at boot invalidates every credential already
# issued. On serverless it would differ per request.
#
# Put the matching PUBLIC key in data/schools.json as issuerPublicKey.
SCHOOL_SIGNING_KEY=
