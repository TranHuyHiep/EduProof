# Next.js
.next/
out/
build/
dist/

# Exception: the compiled contract. See the Midnight section below for why.
# A negation cannot re-include a file whose PARENT directory is excluded, so
# the directory is un-ignored first, then its contents.
!contracts/build/
!contracts/build/**


# Production
*.tsbuildinfo
next-env.d.ts

